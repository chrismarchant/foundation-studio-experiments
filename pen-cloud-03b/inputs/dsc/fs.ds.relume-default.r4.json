 "changeLog": [
  {
   "kind": "specification",
   "id": "DSC-R4-01",
   "change": "Text column width. Added token fs.token.size.text-column.max (768px) and binding textColumnMaxWidth on fs.section.hero, fs.section.features, fs.section.testimonials and fs.section.cta. The section text column (hero text block, features header, testimonials header, CTA container) is min(container width, 768 px), centred where the section centres it and left-aligned in the features section; this replaces the 512 px design observation (Tailwind default max-w-lg) that the Penpot boards carried and that r1-r3 consumed; the boards are reconciled under OD-50.",
   "evidence": "PEN-CLOUD-03-B run r3 defect attribution D-11; owner ruling OD-50 (Penpot reconciliation); Relume preset maxWidth.lg = 48rem (max-w-lg)"
  },
  {
   "kind": "specification",
   "id": "DSC-R4-02",
   "change": "Button sizing. fs.component.button.primary and fs.component.button.secondary geometry is now height 50, paddingX 24, paddingY 12, gap 12, strokeWidth 1, labelLineHeight 24, sizing padding, with a sizingRule. Relume px-6 py-3 with a 1 px border and the 24 px body line height renders 50 px tall; the Penpot mains were 48 px with an inner stroke and are reconciled (inner stroke represented inside the padding: 13/25 px) under OD-50.",
   "evidence": "PEN-CLOUD-03-B run r3 defect attribution D-14; owner ruling OD-50 (Penpot reconciliation); Relume class rule px-6 py-3 with border"
  },
  {
   "kind": "specification",
   "id": "DSC-R4-03",
   "change": "Mobile quote-card spacing. Added token fs.token.space.gap.5 (20px) and a quoteCard rule in fs.section.testimonials layout. Relume stacks the author block below md (flex-col items-start, no gap) and uses mb-5/mt-5 (20 px) around the quote below md and mb-6/mt-6 (24 px) from md; the Penpot mobile board carried a row author block with a 16 px gap and 24 px spaces and is reconciled under OD-50.",
   "evidence": "PEN-CLOUD-03-B run r3 defect attribution D-15; owner ruling OD-50 (Penpot reconciliation); Relume class rule flex-col items-start, mb-5/mt-5 md:mb-6/md:mt-6"
  },
  {
   "kind": "specification",
   "id": "DSC-R4-04",
   "change": "Hero image columns. fs.section.hero interaction.imageLayout gains columnInset (layout.sidePadding), aspectBase (column), aspectBaseRule and columnInsetRule. Relume's columns are absolutely positioned inside a section with 5 % side padding, and percentage padding resolves against the shrink-wrapped column; r1-r3 placed the columns at the stage edge and resolved the aspect per image; the Penpot boards are reconciled under OD-50.",
   "evidence": "PEN-CLOUD-03-B run r3 defect attribution D-13; owner ruling OD-50 (Penpot reconciliation); Relume class rule pt-[120%] in absolutely positioned columns"
  },
  {
   "kind": "specification",
   "id": "DSC-R4-05",
   "change": "Tier-aware grid gap. Added token fs.token.space.grid.gap (32px; sm 24px) and rebound the fs.section.testimonials gridGap binding to it (features gridGap stays on fs.token.space.gap.8). The testimonial grid gap is 24 px below md and 32 px from md; the Penpot mobile board already carries 24 px.",
   "evidence": "PEN-CLOUD-03-B run r3 defect attribution D-12; owner ruling OD-50 (Penpot reconciliation); Relume class rule gap-6 md:gap-8"
  }
 ],
