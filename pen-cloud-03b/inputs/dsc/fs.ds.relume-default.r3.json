 "supersedes": "sha256:4243b7aa087b568fcf16cfab27ec72a2f3d04fc13fb5ff81c06c98ae8393cf25",
 "changeLog": [
  {
   "kind": "specification",
   "id": "DSC-R3-01",
   "change": "Breakpoint model. Added top-level `screens` (Relume Tailwind preset theme.screens sm 480 / md 768 / lg 992 / xl 1280 / xxl 1440 with the matching theme.container.screens widths: sm 100%, md 100%, lg 992px, xl 1280px; container centred, 100% below sm, side padding 5% at every width) and `screensProvenance`. `breakpoints` keeps its three design tiers (the three Penpot canvases 1440/768/375) and their ids; lg.minWidth corrected from 1024 to 992, a `screen` field added to each (lg -> lg, md -> md, sm -> null) and `breakpointsNote` added to state that breakpoints are design tiers while the width-dependent container rule is screens[].container.",
   "evidence": "PEN-CLOUD-03-B run r2 defect attribution D-3; Relume preset @relume_io/relume-tailwind 1.3.0 theme.screens and theme.container.screens"
  },
  {
   "kind": "specification",
   "id": "DSC-R3-02",
   "change": "Hero image height rule. fs.section.hero interaction.imageLayout gains minHeightBelowScreen {screen: sm, value: 35vw}: below screens.sm (480px) every hero image box has min-height 35vw in addition to its 120% aspect padding (Relume `h-[35vw] pt-[120%] sm:h-auto` under border-box sizing, so the rendered height is max(35vw, 1.2 x width)); from sm the aspect alone applies. PEN-CLOUD-02 omitted this rule from the stored animation spec, and the r2 result record mis-stated the threshold as 640px; the preset sm screen is 480px.",
   "evidence": "PEN-CLOUD-03-B run r2 defect attribution D-4; Relume preset @relume_io/relume-tailwind 1.3.0 theme.screens.sm"
  },
  {
   "kind": "specification",
   "id": "DSC-R3-03",
   "change": "Hero text block. Added spacing tokens fs.token.space.hero.text-top (112px; md 96px; sm 64px) and fs.token.space.hero.text-bottom (112px; md 96px; sm inherits md), bindings textPaddingTop and textPaddingBottom on fs.section.hero, and a layout.textBlock rule. The Relume model places the hero text in a full-height flex container with items-center and padding pt-16 pb-24 (sm), pt-24 pb-24 (md), py-28 (lg); r1/r2 centred the text in the full stage with no padding.",
   "evidence": "PEN-CLOUD-03-B run r2 defect attribution D-4; Relume preset @relume_io/relume-tailwind 1.3.0 spacing scale (pt-16, pt-24, pb-24, py-28)"
  },
  {
   "kind": "specification",
   "id": "DSC-R3-04",
   "change": "Testimonials grid. fs.section.testimonials gains layout.grid: minmax(0, 1fr) tracks; cumulative mobile-first rules (base 1 column / auto rows; from sm 4 rows; from md 2 columns; from lg 4 columns and 2 rows); quote card spans 2 columns from sm; card index 2 is ordered last below lg; explicit rows are equal fr tracks with cards stretched. With a four-row template and no explicit columns, a two-column span forces the implicit grid to two columns from sm; r1/r2 emitted explicit columns only and no row template.",
   "evidence": "PEN-CLOUD-03-B run r2 defect attribution D-5; Relume preset @relume_io/relume-tailwind 1.3.0 theme.screens (Testimonial37 responsive classes)"
  }
 ],
