{
  "designObservationVsIntent": [
    {
      "id": "button.secondary.fill",
      "intent": "DSC binds Secondary fill to fs.token.color.scheme.foreground (#ffffff)",
      "observed": "Penpot Secondary button instance carries no fill (stroke only)",
      "resolution": "DSC wins: background is the bound token"
    },
    {
      "id": "button.width.stroke",
      "intent": "DSC geometry: paddingX 24, strokeWidth 1 (CSS border + padding)",
      "observed": "Penpot Primary is 95px wide with an inner stroke (24 + label + 24); a CSS border adds 2px",
      "resolution": "CSS border-box with 1px border and 24px padding kept (rendered width is label + 50px)"
    },
    {
      "id": "container.fluid",
      "intent": "DSC breakpoints list container 1280 / 691 / 337 with 5% side padding",
      "observed": "691 and 337 equal 90% of the 768 and 375 canvases (canvas minus 5% padding each side)",
      "resolution": "Container is fluid: max-width follows screens[].container (sm 480px: 100%, md 768px: 100%, lg 992px: 992px, xl 1280px: 1280px, xxl 1440px: 1280px) inside 5% side padding; md/sm values arise from the padding"
    },
    {
      "id": "features.grid-gap.sm",
      "intent": "DSC binds features gridGap to fs.token.space.gap.8 (32px); 1 column with no dividers at sm",
      "observed": "Penpot mobile Grid gap is 0px; rows are ruled by 1px top/bottom lines",
      "resolution": "gridGap token applied between columns from md; at sm rows are stacked with 1px rules and no extra gap"
    },
    {
      "id": "hero.text-offset.lg",
      "intent": "Hero text block vertically centred in the 100vh sticky stage's padded content box (DSC layout.textBlock; padding-top 112px = fs.token.space.hero.text-top, padding-bottom 112px = fs.token.space.hero.text-bottom at lg; net shift of the block 0px from the stage centre)",
      "observed": "Penpot lg: text block top 320px vs 256.5px if centred (63.5px lower)",
      "resolution": "DSC wins: centred in the padded stage with the bound paddings; the Penpot offset is not reproduced as a separate value"
    },
    {
      "id": "hero.text-offset.md",
      "intent": "Hero text block vertically centred in the 100vh sticky stage's padded content box (DSC layout.textBlock; padding-top 96px = fs.token.space.hero.text-top, padding-bottom 96px = fs.token.space.hero.text-bottom at md; net shift of the block 0px from the stage centre)",
      "observed": "Penpot md: text block top 382px vs 318.5px if centred (63.5px lower)",
      "resolution": "DSC wins: centred in the padded stage with the bound paddings; the Penpot offset is not reproduced as a separate value"
    },
    {
      "id": "hero.text-offset.sm",
      "intent": "Hero text block vertically centred in the 100vh sticky stage's padded content box (DSC layout.textBlock; padding-top 64px = fs.token.space.hero.text-top, padding-bottom 96px = fs.token.space.hero.text-bottom at sm; net shift of the block -16px from the stage centre)",
      "observed": "Penpot sm: text block top 276px vs 171.5px if centred (104.5px lower)",
      "resolution": "DSC wins: centred in the padded stage with the bound paddings; the Penpot offset is not reproduced as a separate value"
    },
    {
      "id": "navbar.links.count",
      "intent": "DSC navbar interaction.menu.links: 8 links",
      "observed": "copy.json provides 4 links; Penpot boards show only the closed bar",
      "resolution": "copy.json wins for the link count (copy is identical across arms)"
    },
    {
      "id": "testimonials.grid-gap.sm",
      "intent": "DSC binds gridGap to fs.token.space.gap.8 = 32px at every breakpoint",
      "observed": "Penpot mobile Grid gap is 24px",
      "resolution": "DSC wins: 32px at sm as well"
    },
    {
      "id": "testimonials.order.below-lg",
      "intent": "Owner task statement: card index 2 (first quote card) is ordered last below lg",
      "observed": "Penpot tablet/mobile boards keep DOM order (logo, logo, quote, quote, logo, logo) with both quote cards adjacent",
      "resolution": "Task statement followed (CSS order: 1 on card index 2 below lg)"
    }
