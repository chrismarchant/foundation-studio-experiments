{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "generator/**",
      "app/src/**",
      "app/vite.config.ts",
      "ssr/src/**",
      "ssr/vite.config.ts",
      "ssr/server.mjs",
      "!**/routeTree.gen.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120, "lineEnding": "lf" },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["app/src/generated/**"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false },
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "style": { "useTemplate": "off" },
          "suspicious": { "noArrayIndexKey": "off" },
          "a11y": { "useValidAnchor": "off" }
        }
      }
    }
  ]
}
